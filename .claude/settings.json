{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python:*)",
      "Bash(python3 scripts/check_perimeter.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Read(**/*-sa.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.*.local)",
      "Bash(cat *.env.development)",
      "Bash(cat *.env.production)",
      "Bash(cat *.env.staging)",
      "Bash(cat *.env.test)",
      "Bash(cat *.envrc)",
      "Bash(cat **-sa.json)",
      "Bash(cat **.pem)",
      "Bash(cat **.key)",
      "Bash(cat **.p12)",
      "Bash(head *.env)",
      "Bash(head *.env.local)",
      "Bash(head *.env.*.local)",
      "Bash(head *.env.development)",
      "Bash(head *.env.production)",
      "Bash(head *.env.staging)",
      "Bash(head *.env.test)",
      "Bash(head *.envrc)",
      "Bash(head **-sa.json)",
      "Bash(head **.pem)",
      "Bash(head **.key)",
      "Bash(head **.p12)",
      "Bash(tail *.env)",
      "Bash(tail *.env.local)",
      "Bash(tail *.env.*.local)",
      "Bash(tail *.env.development)",
      "Bash(tail *.env.production)",
      "Bash(tail *.env.staging)",
      "Bash(tail *.env.test)",
      "Bash(tail *.envrc)",
      "Bash(tail **-sa.json)",
      "Bash(tail **.pem)",
      "Bash(tail **.key)",
      "Bash(tail **.p12)",
      "Bash(less *.env)",
      "Bash(less *.env.local)",
      "Bash(less *.env.*.local)",
      "Bash(less *.env.development)",
      "Bash(less *.env.production)",
      "Bash(less *.env.staging)",
      "Bash(less *.env.test)",
      "Bash(less *.envrc)",
      "Bash(less **-sa.json)",
      "Bash(less **.pem)",
      "Bash(less **.key)",
      "Bash(less **.p12)"
    ]
  }
